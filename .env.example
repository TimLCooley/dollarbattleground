# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# used by scripts/produce-clip.mjs (GitHub Actions) — same project
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# ── Stripe (mode is flipped in /admin; both sets live in env) ────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY_LIVE=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_LIVE=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...   # the LIVE-mode endpoint's signing secret

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_...              # sending
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=Dollar Battleground
RESEND_WEBHOOK_SECRET=whsec_...    # inbound webhook (Svix) signing secret
RESEND_INBOUND_API_KEY=re_...      # full-access key, to read inbound bodies
FORWARD_INBOUND_TO=you@example.com

# ── X (Twitter): one app per faction account, OAuth 1.0a ─────────────────────
X_RED_API_KEY=
X_RED_API_SECRET=
X_RED_TOKEN=
X_RED_SECRET=
X_BLUE_API_KEY=
X_BLUE_API_SECRET=
X_BLUE_TOKEN=
X_BLUE_SECRET=

# ── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...       # workspace-scoped; the General, Intel, Social copy
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=                    # fallback copy + the field radio
GEMINI_MODEL=gemini-3.6-flash
HEYGEN_API_KEY=sk_V2_...           # video; bills the pay-as-you-go wallet

# ── Ops ──────────────────────────────────────────────────────────────────────
CRON_SECRET=random_hex             # pg_cron → /api/cron/autopilot bearer
